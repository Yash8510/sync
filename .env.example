# ==============================================================================
# S.Y.N.C. - Environment Variables Template
# Copy this file to '.env' and configure your local environment settings.
# ==============================================================================

# Application Environment: development, staging, production
SYNC_ENV=development

# Optional: Override default config file path
# SYNC_CONFIG_PATH=config/default.yaml

# Optional: CUDA Device Configuration (e.g., 0, 1)
# CUDA_VISIBLE_DEVICES=0

# Optional: Local LLM Brain API Endpoint (Phase 3)
# OLLAMA_BASE_URL=http://localhost:11434
